# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_SETTINGS_MODULE=tenohms.settings.pythonanywhere

# Database — MySQL (PythonAnywhere free tier default)
# For paid plans using PostgreSQL, change DB_ENGINE to django.db.backends.postgresql
# and set DB_PORT to 5432
DB_ENGINE=django.db.backends.mysql
DB_NAME=yourusername$thhims_db
DB_USER=yourusername
DB_PASSWORD=your-mysql-password
DB_HOST=yourusername.mysql.pythonanywhere.com
DB_PORT=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=THHIMS <noreply@tenohms.com>

# Security
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# ─────────────────────────────────────────────────────────────────────────────
# PYTHONANYWHERE DEPLOYMENT STEPS
# ─────────────────────────────────────────────────────────────────────────────
# 1. Push code to GitHub/GitLab
# 2. On PythonAnywhere: Open Bash console
#    git clone <your-repo-url> TenoHMS
#    cd TenoHMS
#    python3 -m venv venv
#    source venv/bin/activate
#    pip install -r requirements.txt
#
# 3. Create .env file on PythonAnywhere with the values above
#
# 4. Go to Web tab → Add new web app → Manual configuration → Python 3.x
#    - Set WSGI configuration file path to:
#      /home/yourusername/TenoHMS/tenohms/wsgi.py
#
# 5. In the WSGI config file on PythonAnywhere, make sure it contains:
#    import os
#    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "tenohms.settings.pythonanywhere")
#    try:
#        from dotenv import load_dotenv
#        load_dotenv()
#    except ImportError:
#        pass
#    from django.core.wsgi import get_wsgi_application
#    application = get_wsgi_application()
#
# 6. In PythonAnywhere Web tab → Static files:
#    URL: /static/
#    Directory: /home/yourusername/TenoHMS/staticfiles
#
#    URL: /media/
#    Directory: /home/yourusername/TenoHMS/media
#
# 7. In PythonAnywhere Web tab → WSGI configuration file:
#    Add: project_home = '/home/yourusername/TenoHMS'
#    Add: sys.path.insert(0, project_home)
#
# 8. Run in Bash console:
#    cd TenoHMS
#    source venv/bin/activate
#    python manage.py collectstatic --noinput
#    python manage.py migrate
#    python manage.py createsuperuser
#
# 9. Click "Reload" on the Web tab
# ─────────────────────────────────────────────────────────────────────────────
